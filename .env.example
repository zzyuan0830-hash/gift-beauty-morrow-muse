# Server only. Never use a Bingkui shop/token. Default is closed.
# design: visual preview only; no Shopify cart or payment
STORE_MODE=maintenance
STORE_INDEPENDENT_CONFIRMED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-10
# 32 random bytes, base64; generate with: openssl rand -base64 32
CART_COOKIE_SECRET=
SITE_URL=http://localhost:3000
# Exact additional checkout host, if Shopify uses a verified custom domain
SHOPIFY_CHECKOUT_HOST=
# Set only after shop payment test mode has been verified
SHOPIFY_TEST_PAYMENTS_CONFIRMED=false
# Requires completed config/launch.json and approved release
LAUNCH_APPROVED=false
